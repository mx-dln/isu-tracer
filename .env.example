# ============================================================
# ISU-Cauayan IAT Tracer Study - Environment Configuration
# Copy this file to .env and adjust values for your setup.
# NEVER commit the real .env file.
# ============================================================

# ---- Application ----
APP_NAME="ISU-Cauayan IAT Tracer Study"
APP_ENV=local
APP_URL=http://localhost:8080
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_KEY=base64:5VDV6ovAiqJItj+eGevhQJbnsPfrkbBkLyDiO8dhglo=

# ---- Session ----
SESSION_LIFETIME=120
SESSION_NAME=iat_tracer_session

# ---- Database ----
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=tracer
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ---- Mail (PHPMailer / SMTP) ----
# Leave MAIL_HOST empty to disable real email delivery (mail will be
# logged to storage/logs instead).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="ISU IAT Tracer"
MAIL_DEBUG=false

# ---- SMS (Semaphore) ----
# Set SEMAPHORE_API_KEY to enable real SMS delivery.
# In local/test environments keep NOTIFICATION_TEST_MODE=true so no real
# SMS/email is sent (attempts are logged as "simulated").
SEMAPHORE_API_KEY=<configured-in-.env>
SEMAPHORE_SENDER_NAME=<configured-in-.env>
SEMAPHORE_API_URL=https://api.semaphore.co/api/v4/messages
NOTIFICATION_TEST_MODE=true

# ---- Security ----
# Increase attempts for local testing, reduce for production.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
