# ============================================================
# ISU-Cauayan IAT Tracer Study - Root Directory Handler
# ============================================================
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct web access to sensitive files
    RewriteRule ^(\.env|\.git|storage/logs|.*\.sql) - [F,L,NC]

    # Forward all web requests to public/ subfolder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
