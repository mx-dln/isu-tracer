{
    "name": "isu/tracer-study",
    "description": "Web-Based Tracer Study with Forecasting and Notification for IAT Graduates at Isabela State University - Cauayan Campus",
    "type": "project",
    "license": "MIT",
    "keywords": ["tracer-study", "isu", "iat", "php", "forecasting"],
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "vlucas/phpdotenv": "^5.6",
        "phpmailer/phpmailer": "^6.9",
        "dompdf/dompdf": "^3.0",
        "phpoffice/phpspreadsheet": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "setup:db": [
            "@php database/migrations/migrate.php",
            "@php database/seeders/seed.php"
        ]
    }
}
